    {
        "id": "choco_ctrl_logic_2026",
        "type": "function",
        "z": "choco_flow_2026",
        "name": "Lógica de control",
        "func": "const c = msg.payload;\nif (!c || typeof c !== 'object') return null;\n\nconst cfg = flow.get('cfg') || {sp: 48, kp: 15, ki: 0.05, kd: 5};\nconst manual = flow.get('modo_manual') === true;\nconst vacio = {bomba:false, valvula:false, niquelina:false, agitador:false};\nconst m = x => ({payload: x});\n// Salida 1: comandos hacia el ESP32.  Salida 2: avisos al dashboard.\n\nif (c.cmd === 'modo') {\n    flow.set('man', Object.assign({}, vacio));\n    if (c.valor === 'manual') {\n        // Entra a manual con todo apagado\n        return [[m({cmd:'bomba', valor:false}), m({cmd:'valvula', valor:false}),\n                 m({cmd:'niquelina', valor:false}), m({cmd:'agitador', valor:false}), m(c)], null];\n    }\n    // Automático: modo + setpoint fijo + PID suave\n    return [[m(c), m({cmd:'setpoint', valor:cfg.sp}),\n             m({cmd:'pid', kp:cfg.kp, ki:cfg.ki, kd:cfg.kd})], null];\n}\n\nif (['bomba', 'valvula', 'niquelina', 'agitador'].includes(c.cmd)) {\n    if (!manual) return null;          // solo se accionan en modo manual\n\n    // La niquelina no se enciende si el pulmón ya está en o sobre el setpoint\n    if (c.cmd === 'niquelina' && c.valor === true) {\n        const u = flow.get('ultimo_d') || {};\n        const pul = Number(u.temp_pulmon), sp = Number(u.setpoint);\n        if (u.temp_valida === true && Number.isFinite(pul) && Number.isFinite(sp) && pul >= sp) {\n            const hora = new Date().toLocaleTimeString('es-CO');\n            return [null, m(hora + ' · NIQUELINA_BLOQUEADA: pulmón a ' + pul.toFixed(1) +\n                ' °C, por encima del setpoint (' + sp.toFixed(1) + ' °C)')];\n        }\n    }\n\n    const man = flow.get('man') || Object.assign({}, vacio);\n    man[c.cmd] = c.valor === true;\n    flow.set('man', man);\n    return [m(c), null];\n}\n\nif (c.cmd === 'setpoint') return manual ? [m(c), null] : null;   // en automático es fijo\n\nreturn [m(c), null];",
