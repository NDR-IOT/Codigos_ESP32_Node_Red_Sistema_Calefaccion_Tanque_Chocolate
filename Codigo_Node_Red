        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<style>\n.ct{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:100%}\n.ct button{width:100%;border:0;border-radius:8px;padding:13px 6px;font-weight:600;font-size:13px;letter-spacing:.5px;color:#fff;background:#9e9e9e;cursor:pointer;transition:background .2s}\n.ct button.on{background:#2e7d32}\n.ct button.bad{background:#c62828}\n.ct button.rearm{background:#6d4c41;grid-column:1/-1}\n.ct button.rearm:not(:disabled){background:#c62828}\n.ct button:disabled{opacity:.4;cursor:not-allowed}\n.ct .bw{display:flex;flex-direction:column}\n.ct .why{font-size:11px;color:#c62828;margin:3px 2px 0;line-height:1.25}\n.ct .offb{grid-column:1/-1;background:#c62828;color:#fff;border-radius:10px;padding:10px 12px;font-weight:700;text-align:center}\n.ct .offb small{display:block;font-weight:400;font-size:12px;margin-top:2px}\n</style>\n<div class=\"ct\">\n  <div class=\"offb\" ng-if=\"msg.payload.offline\">⚠ SIN CONEXIÓN CON EL ESP32\n    <small ng-if=\"msg.payload.controles_apagados\">Controles apagados por falta de comunicación</small></div>\n  <button ng-disabled=\"msg.payload.offline\" ng-class=\"{on: msg.payload.modo_manual===true}\" ng-click=\"send({payload:{cmd:'modo',valor:'manual'}})\">MODO MANUAL</button>\n  <button ng-disabled=\"msg.payload.offline\" ng-class=\"{on: msg.payload.modo_manual===false}\" ng-click=\"send({payload:{cmd:'modo',valor:'automatico'}})\">MODO AUTOMÁTICO</button>\n\n  <div class=\"bw\">\n    <button ng-disabled=\"!msg.payload.modo_manual || msg.payload.offline\"\n            ng-class=\"{on: msg.payload.man_valvula && !msg.payload.bloq_valvula, bad: msg.payload.man_valvula && msg.payload.bloq_valvula}\"\n            ng-click=\"send({payload:{cmd:'valvula',valor:!msg.payload.man_valvula}})\">VÁLVULA: {{msg.payload.man_valvula ? 'ABIERTA' : 'CERRADA'}}</button>\n    <div class=\"why\" ng-if=\"msg.payload.man_valvula && msg.payload.bloq_valvula\">No enciende: {{msg.payload.bloq_valvula}}</div>\n  </div>\n  <div class=\"bw\">\n    <button ng-disabled=\"!msg.payload.modo_manual || msg.payload.offline\"\n            ng-class=\"{on: msg.payload.man_bomba && !msg.payload.bloq_bomba, bad: msg.payload.man_bomba && msg.payload.bloq_bomba}\"\n            ng-click=\"send({payload:{cmd:'bomba',valor:!msg.payload.man_bomba}})\">BOMBA: {{msg.payload.man_bomba ? 'ON' : 'OFF'}}</button>\n    <div class=\"why\" ng-if=\"msg.payload.man_bomba && msg.payload.bloq_bomba\">No enciende: {{msg.payload.bloq_bomba}}</div>\n  </div>\n  <div class=\"bw\">\n    <button ng-disabled=\"!msg.payload.modo_manual || msg.payload.offline\"\n            ng-class=\"{on: msg.payload.man_niquelina && !msg.payload.bloq_niquelina, bad: msg.payload.man_niquelina && msg.payload.bloq_niquelina}\"\n            ng-click=\"send({payload:{cmd:'niquelina',valor:!msg.payload.man_niquelina}})\">NIQUELINA: {{msg.payload.man_niquelina ? 'ON' : 'OFF'}}</button>\n    <div class=\"why\" ng-if=\"msg.payload.man_niquelina && msg.payload.bloq_niquelina\">No enciende: {{msg.payload.bloq_niquelina}}</div>\n  </div>\n  <div class=\"bw\">\n    <button ng-disabled=\"!msg.payload.modo_manual || msg.payload.offline\"\n            ng-class=\"{on: msg.payload.man_agitador && !msg.payload.bloq_agitador, bad: msg.payload.man_agitador && msg.payload.bloq_agitador}\"\n            ng-click=\"send({payload:{cmd:'agitador',valor:!msg.payload.man_agitador}})\">AGITADOR: {{msg.payload.man_agitador ? 'ON' : 'OFF'}}</button>\n    <div class=\"why\" ng-if=\"msg.payload.man_agitador && msg.payload.bloq_agitador\">No enciende: {{msg.payload.bloq_agitador}}</div>\n  </div>\n\n  <button class=\"rearm\" ng-disabled=\"msg.payload.estado!='FALLA'\" ng-click=\"send({payload:{cmd:'reset_falla'}})\">REARMAR FALLA</button>\n</div>",
