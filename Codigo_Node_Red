        "id": "choco_process_2026",
        "type": "function",
        "z": "choco_flow_2026",
        "name": "Procesar telemetría",
        "func": "// ===== AJUSTES DEL MODO AUTOMÁTICO (puedes cambiarlos) =====\nconst CFG = {sp: 48.0, kp: 15, ki: 0.05, kd: 5};\n// ============================================================\nflow.set('cfg', CFG);\n\nlet d = msg.payload;\nif (typeof d === 'string') {\n    try { d = JSON.parse(d); }\n    catch (e) { node.warn('Telemetría JSON inválida'); return null; }\n}\nif (!d || typeof d !== 'object') return null;\n\nconst c = Number(d.codigo_falla || 0);\nconst timeout = (c & 8) !== 0;\nflow.set('falla_timeout', timeout);\n\n// Un sensor se considera malo por el bit de falla O por lectura inválida en vivo\n// (igual que el OLED del ESP32). Con timeout de llenado se oculta el aviso de sensores.\nconst tempMal = (c & 1) !== 0 || d.temp_valida === false;\nconst nivelMal = (c & 2) !== 0 || d.nivel_valida === false;\nconst f = [];\nif (!timeout && tempMal) f.push('Sensor de temperatura inválido');\nif (!timeout && nivelMal) f.push('Sensor de nivel sin lectura válida');\nif (c & 4) f.push('Sobretemperatura del pulmón');\nif (c & 8) f.push('Timeout de llenado');\nif (c & 16) f.push('Sobretemperatura del encamisado');\nd.fallas_txt = f.join(', ');\nd.offline = false;\n\n// Alerta de nivel generada aquí en Node-RED (el ESP32 no la envía por MQTT).\n// Se emite al pasar de nivel bueno a malo, máximo 1 vez cada 30 s.\nconst alertas = [];      // avisos que se muestran en el dashboard\nconst cmdsGuard = [];    // comandos de seguridad hacia el ESP32\nconst prevMal = flow.get('nivel_mal_prev') === true;\nflow.set('nivel_mal_prev', nivelMal);\nif (nivelMal && !prevMal && !timeout) {\n    const ahoraA = Date.now();\n    if (ahoraA - (context.get('ult_alerta_nivel') || 0) > 30000) {\n        context.set('ult_alerta_nivel', ahoraA);\n        alertas.push({payload: new Date().toLocaleTimeString('es-CO') + ' · SENSOR_NIVEL_INVALIDO: Sensor de nivel sin lectura válida'});\n    }\n}\n\n// El ESP32 no informa qué botones se pidieron: Node-RED lo recuerda\nflow.set('modo_manual', d.modo_manual === true);\nlet man = flow.get('man') || {bomba:false, valvula:false, niquelina:false, agitador:false};\nif (!d.modo_manual) {\n    man = {bomba:false, valvula:false, niquelina:false, agitador:false};\n    flow.set('man', man);\n}\n// Seguridad de proceso en manual: la niquelina no puede quedar pedida con el pulmón\n// en o por encima del setpoint. Se apaga el pedido, se envía OFF y se avisa.\nif (d.modo_manual && man.niquelina && d.temp_valida === true &&\n    Number(d.temp_pulmon) >= Number(d.setpoint)) {\n    man.niquelina = false;\n    flow.set('man', man);\n    cmdsGuard.push({payload: {cmd: 'niquelina', valor: false}});\n    alertas.push({payload: new Date().toLocaleTimeString('es-CO') + ' · NIQUELINA_APAGADA: pulmón a ' +\n        Number(d.temp_pulmon).toFixed(1) + ' °C alcanzó el setpoint (' + Number(d.setpoint).toFixed(1) + ' °C)'});\n}\nd.man_bomba = man.bomba;\nd.man_valvula = man.valvula;\nd.man_niquelina = man.niquelina;\nd.man_agitador = man.agitador;\n\n// ---- Motivo por el que un equipo pedido en manual NO enciende (vacío = sin impedimento)\nconst num = x => Number(x);\nconst T = d.temp_valida === true, Nv = d.nivel_valida === true;\nconst cok = d.cargas_ok;   // true/false; undefined si el ESP32 es de la versión anterior\nconst est = d.estado;\nconst pul = num(d.temp_pulmon), enc = num(d.temp_encamisado), niv = num(d.nivel_cm), sp = num(d.setpoint);\nconst lim = sp + 4;\nconst comun = () => {\n    if (est === 'FALLA') return 'Sistema en FALLA: rearme primero';\n    if (!T) return 'Sensores de temperatura sin lectura válida';\n    if (!Nv) return 'Sensor de nivel sin lectura válida';\n    return '';\n};\nconst motivo = {bomba: '', valvula: '', niquelina: '', agitador: ''};\nif (d.modo_manual) {\n    if (man.bomba) {\n        motivo.bomba = comun()\n            || (est !== 'NORMAL' ? 'Estado ' + est + ': la bomba solo funciona en NORMAL' : '')\n            || (niv > 4 ? 'Nivel bajo (' + niv.toFixed(1) + ' cm; debe ser 4 cm o menos)' : '')\n            || (cok === false ? 'Nivel sin confirmar (necesita 5 lecturas estables de 4 cm o menos)' : '')\n            || (pul < 36 ? 'Pulmón a ' + pul.toFixed(1) + ' °C (mínimo 36 °C)' : '')\n            || (d.valvula ? 'Válvula abierta' : '')\n            || (num(d.velocidad_bomba) <= 0 ? 'Velocidad de bomba en 0 %' : '');\n        if (d.bomba) motivo.bomba = '';\n    }\n    if (man.niquelina) {\n        motivo.niquelina = comun()\n            || (est !== 'NORMAL' ? 'Estado ' + est + ': la niquelina solo funciona en NORMAL' : '')\n            || (niv > 4 ? 'Nivel bajo (' + niv.toFixed(1) + ' cm; debe ser 4 cm o menos)' : '')\n            || (cok === false ? 'Nivel sin confirmar (necesita 5 lecturas estables de 4 cm o menos)' : '')\n            || (d.valvula ? 'Válvula abierta' : '')\n            || ((pul >= lim || enc >= lim) ? 'Temperatura sobre el límite (' + lim.toFixed(0) + ' °C)' : '');\n        if (d.niquelina) motivo.niquelina = '';\n    }\n    if (man.valvula) {\n        motivo.valvula = comun()\n            || (c !== 0 ? 'Hay una falla activa' : '')\n            || (niv <= 3 ? 'Nivel alcanzado (' + niv.toFixed(1) + ' cm; ya está lleno)' : '')\n            || ((pul >= lim || enc >= lim) ? 'Temperatura sobre el límite (' + lim.toFixed(0) + ' °C)' : '');\n        if (d.valvula) motivo.valvula = '';\n    }\n    if (man.agitador) {\n        motivo.agitador = (est === 'FALLA' ? 'Sistema en FALLA: rearme primero' : '')\n            || (est === 'INIT' ? 'Estado INIT: faltan lecturas o el nivel no está confirmado' : '')\n            || (!T ? 'Sensores de temperatura sin lectura válida' : '')\n            || (!d.agitador && enc < 30 ? 'Encamisado a ' + enc.toFixed(1) + ' °C (enciende desde 30 °C)' : '');\n        if (d.agitador) motivo.agitador = '';\n    }\n}\nd.bloq_bomba = motivo.bomba;\nd.bloq_valvula = motivo.valvula;\nd.bloq_niquelina = motivo.niquelina;\nd.bloq_agitador = motivo.agitador;\n\n// Se guarda el último dato completo para mostrarlo si se pierde la comunicación\nflow.set('ultimo_d', JSON.parse(JSON.stringify(d)));\n\n// Si un sensor no tiene lectura válida (el ESP32 manda 0), se conserva la última lectura buena\nconst guardado = flow.get('ultimas_temps') || {};\nif (Number(d.temp_pulmon) > 0) guardado.p = Number(d.temp_pulmon);\nif (Number(d.temp_encamisado) > 0) guardado.e = Number(d.temp_encamisado);\nif (d.nivel_valida === true && Number(d.nivel_cm) > 0) guardado.n = Number(d.nivel_cm);\nflow.set('ultimas_temps', guardado);\n\n// Guardián: en automático el setpoint es siempre CFG.sp y el PID usa CFG\nlet cmds = null;\nif (!d.modo_manual) {\n    const ahora = Date.now();\n    if (ahora - (context.get('ult') || 0) > 5000) {\n        const out = [];\n        if (Math.abs(Number(d.setpoint) - CFG.sp) > 0.05) {\n            out.push({payload: {cmd: 'setpoint', valor: CFG.sp}});\n        }\n        if (Math.abs(Number(d.kp) - CFG.kp) > 0.006 ||\n            Math.abs(Number(d.ki) - CFG.ki) > 0.006 ||\n            Math.abs(Number(d.kd) - CFG.kd) > 0.006) {\n            out.push({payload: {cmd: 'pid', kp: CFG.kp, ki: CFG.ki, kd: CFG.kd}});\n        }\n        if (out.length) { context.set('ult', ahora); cmds = out; }\n    }\n}\n\n// Tras una caída de más de 60 s los botones se apagaron en pantalla; al volver la\n// comunicación se apagan también los pedidos manuales que hayan quedado en el ESP32.\nif (flow.get('resync') === true) {\n    flow.set('resync', false);\n    if (d.modo_manual) {\n        const off = ['bomba', 'valvula', 'niquelina', 'agitador']\n            .map(k => ({payload: {cmd: k, valor: false}}));\n        cmds = (cmds || []).concat(off);\n    }\n}\n\nif (cmdsGuard.length) cmds = (cmds || []).concat(cmdsGuard);\n\nreturn [\n  {payload: guardado.p !== undefined ? guardado.p : 0},\n  {payload: guardado.e !== undefined ? guardado.e : 0},\n  {payload: guardado.n !== undefined ? guardado.n : 0},\n  {payload: Number(d.pid_pct || 0)},\n  {payload: d},\n  cmds,\n  alertas.length ? alertas : null\n];",
