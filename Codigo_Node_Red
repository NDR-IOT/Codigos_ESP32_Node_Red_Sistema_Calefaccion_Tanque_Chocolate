        "name": "Panel de estado",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<style>\n.pn{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px;width:100%}\n.pn .c{border-radius:10px;padding:8px 12px;background:#eceff1;color:#455a64;line-height:1.3}\n.pn .c small{display:block;font-size:11px;letter-spacing:.6px;text-transform:uppercase;opacity:.75}\n.pn .c b{font-size:16px}\n.pn .full{grid-column:1/-1}\n.pn .on{background:#2e7d32;color:#fff}\n.pn .info{background:#1976d2;color:#fff}\n.pn .bad{background:#c62828;color:#fff}\n.pn .good{background:#e8f5e9;color:#1b5e20}\n.pn.off .c{opacity:.55}\n</style>\n<div class=\"pn\" ng-class=\"{off: msg.payload.offline}\">\n  <div class=\"c full bad\" ng-if=\"msg.payload.offline\" style=\"opacity:1\"><b>⚠ SIN CONEXIÓN CON EL ESP32</b></div>\n  <div class=\"c\" ng-class=\"{on: msg.payload.estado=='NORMAL', info: msg.payload.estado=='RELLENO', bad: msg.payload.estado=='FALLA'}\">\n    <small>Estado</small><b>{{msg.payload.estado || '--'}}</b></div>\n  <div class=\"c\" ng-class=\"{on: msg.payload.estado && !msg.payload.offline}\">\n    <small>Modo</small><b>{{msg.payload.offline ? '--' : (msg.payload.modo_manual ? 'MANUAL' : 'AUTOMÁTICO')}}</b></div>\n  <div class=\"c full\" ng-if=\"!msg.payload.offline\" ng-class=\"msg.payload.fallas_txt ? 'bad' : 'good'\">\n    <small>Fallas</small><b>{{msg.payload.fallas_txt || 'Sin fallas'}}</b></div>\n  <div class=\"c\" ng-class=\"{on: msg.payload.bomba}\">\n    <small>Bomba</small><b>{{msg.payload.bomba ? 'ENCENDIDA' : 'APAGADA'}}</b></div>\n  <div class=\"c\" ng-class=\"{on: msg.payload.valvula}\">\n    <small>Válvula</small><b>{{msg.payload.valvula ? 'ABIERTA' : 'CERRADA'}}</b></div>\n  <div class=\"c\" ng-class=\"{on: msg.payload.niquelina}\">\n    <small>Niquelina</small><b>{{msg.payload.niquelina ? 'ENCENDIDA' : 'APAGADA'}}</b></div>\n  <div class=\"c\" ng-class=\"{on: msg.payload.agitador}\">\n    <small>Agitador</small><b>{{msg.payload.agitador ? 'ENCENDIDO' : 'APAGADO'}}</b></div>\n  <div class=\"c\" ng-class=\"{good: msg.payload.temp_valida, bad: msg.payload.temp_valida===false}\">\n    <small>Sensores de temperatura</small><b>{{msg.payload.temp_valida ? 'VÁLIDOS' : (msg.payload.temp_valida===false ? 'INVÁLIDOS' : '--')}}</b></div>\n  <div class=\"c\" ng-class=\"{good: msg.payload.nivel_valida, bad: msg.payload.nivel_valida===false}\">\n    <small>Sensor de nivel</small><b>{{msg.payload.nivel_valida ? 'VÁLIDO' : (msg.payload.nivel_valida===false ? 'INVÁLIDO' : '--')}}</b></div>\n  <div class=\"c\" ng-class=\"{good: msg.payload.nivel_valida, bad: msg.payload.nivel_valida===false}\">\n    <small>Distancia al líquido</small><b>{{msg.payload.nivel_valida ? (msg.payload.nivel_cm + ' cm') : '--'}}</b></div>\n  <div class=\"c\">\n    <small>Setpoint</small><b>{{msg.payload.setpoint ? (msg.payload.setpoint + ' °C') : '--'}}</b></div>\n  <div class=\"c\">\n    <small>Velocidad de bomba</small><b>{{msg.payload.offline ? '--' : (msg.payload.velocidad_bomba + ' %')}}</b></div>\n</div>",
