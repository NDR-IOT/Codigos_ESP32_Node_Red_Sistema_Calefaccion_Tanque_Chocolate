        "func": "let a = msg.payload;\nif (typeof a === 'string') { try { a = JSON.parse(a); } catch (e) { a = {mensaje: a}; } }\na = a || {};\nconst tipo = a.tipo || 'ALERTA';\n\n// Solo se muestran estas alertas\nconst permitidas = [\n    'SENSOR_TEMP_INVALIDO',\n    'SOBRETEMPERATURA',\n    'SOBRETEMPERATURA_ENCAMISADO',\n    'NIVEL_BAJO',\n    'TIMEOUT_LLENADO',\n    'COMANDO_INVALIDO',\n    'REARME_SOLICITADO',\n    'REARME_RECHAZADO'\n];\nif (!permitidas.includes(tipo)) return null;\n\n// Con falla por timeout de llenado no se muestra el aviso de sensor de temperatura\nif (tipo === 'SENSOR_TEMP_INVALIDO' && flow.get('falla_timeout') === true) return null;\n\n// NIVEL_BAJO se muestra como máximo 1 vez cada 2 minutos\nif (tipo === 'NIVEL_BAJO') {\n    const ult = context.get('ult') || 0;\n    const ahora = Date.now();\n    if (ahora - ult < 120000) return null;\n    context.set('ult', ahora);\n}\n\nconst hora = new Date().toLocaleTimeString('es-CO');\nmsg.payload = hora + ' · ' + tipo + ': ' + (a.mensaje || '');\nreturn msg;",
