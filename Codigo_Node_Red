        "name": "Sin conexión 60 s",
        "func": "// 60 s sin telemetría: medidores a 0, botones apagados y pedidos manuales en OFF\nconst vacio = {bomba:false, valvula:false, niquelina:false, agitador:false};\nflow.set('man', Object.assign({}, vacio));\nflow.set('modo_manual', false);\nflow.set('resync', true);   // al volver la comunicación se re-sincroniza el ESP32\n\nconst ultimo = flow.get('ultimo_d') || {};\nconst d = Object.assign({}, ultimo, {\n    offline: true,\n    controles_apagados: true,\n    estado: 'SIN CONEXIÓN',\n    fallas_txt: '',\n    modo_manual: null,   // ningún botón de modo queda en verde\n    man_bomba: false, man_valvula: false, man_niquelina: false, man_agitador: false,\n    bloq_bomba: '', bloq_valvula: '', bloq_niquelina: '', bloq_agitador: ''\n});\nflow.set('ultimo_d', d);\n\n// Mejor esfuerzo: pedir OFF a los equipos manuales (si el ESP32 aún recibe comandos)\nconst off = ['bomba', 'valvula', 'niquelina', 'agitador']\n    .map(k => ({payload: {cmd: k, valor: false}}));\n\nreturn [{payload: 0}, {payload: 0}, {payload: 0}, {payload: 0}, {payload: d}, off];",
