// Recorta un valor numerico a un intervalo.
float limitar(float valor, float minimo, float maximo) {
  if (valor < minimo) return minimo;
  if (valor > maximo) return maximo;
  return valor;
}

// Aplica la logica LOW=ON de valvula y agitador.
// No se utiliza para el SSR de resistencia, cuya logica es distinta.
void setRelay(uint8_t pin, bool encendido) {
  digitalWrite(pin, encendido ? RELAY_ON : RELAY_OFF);
}

// Convierte el estado interno a texto para JSON, OLED y serial.
const char* nombreEstado() {
  switch (estado) {
    case EST_INIT:
      return "INIT";
    case EST_NORMAL:
      return "NORMAL";
    case EST_RELLENO:
      return "RELLENO";
    case EST_FALLA:
      return "FALLA";
  }

  return "?";
}

// Imprime los ocho bytes del identificador de un DS18B20.
void imprimirDireccion(const DeviceAddress direccion) {
  for (uint8_t indice = 0; indice < 8; indice++) {
    if (direccion[indice] < 16) Serial.print('0');
    Serial.print(direccion[indice], HEX);
    if (indice < 7) Serial.print(' ');
  }

  Serial.println();
}

// ============================================================================
// 11. DISPONIBILIDAD DE SENSORES Y PERMISOS
// ============================================================================

// Una lectura debe ser valida Y suficientemente reciente.
bool pulmonDisponible() {
  return tempPulmonValida &&
         millis() - ultimaTempPulmonValidaMs <= TEMP_MAX_EDAD_MS;
}

bool encamisadoDisponible() {
  return tempEncamisadoValida &&
         millis() - ultimaTempEncamisadoValidaMs <= TEMP_MAX_EDAD_MS;
}

bool temperaturasDisponibles() {
  return pulmonDisponible() && encamisadoDisponible();
}

bool nivelDisponible() {
  return nivelValida &&
         millis() - ultimoNivelValidoMs <= NIVEL_MAX_EDAD_MS;
}

// Revisa la dispersion de la ventana de nivel.
// No calcula un promedio: compara la lectura maxima con la minima.
bool nivelEstable() {
  if (nivelMuestrasN < NIVEL_MUESTRAS) return false;

  float minimo = nivelMuestras[0];
  float maximo = nivelMuestras[0];

  for (int indice = 1; indice < NIVEL_MUESTRAS; indice++) {
    if (nivelMuestras[indice] < minimo) {
      minimo = nivelMuestras[indice];
    }

    if (nivelMuestras[indice] > maximo) {
      maximo = nivelMuestras[indice];
    }
  }

  return (maximo - minimo) <= NIVEL_DISPERSION_MAX_CM;
}

// Este es el dato cargasOK del monitor.
// Solo representa el permiso de NIVEL.
// Todavia se necesitan otras condiciones para activar bomba o resistencia:
// estado normal, temperaturas disponibles, valvula desactivada, etc.
bool nivelConfirmadoParaCargas() {
  return nivelDisponible() &&
         nivelCm <= DISTANCIA_MAX_CARGAS_CM &&
         contadorNivelSeguro >= NIVEL_CONFIRMACIONES_CARGAS &&
         nivelEstable();
}

// Permisos adicionales de la valvula cuando esta en modo manual.
bool seguridadValvulaManual() {
  return modoManual &&
         estado != EST_FALLA &&
         temperaturasDisponibles() &&
         nivelDisponible() &&
         nivelCm > DISTANCIA_FIN_LLENADO_CM &&
         tempPulmon < setpoint + MARGEN_SOBRETEMP_C &&
         tempEncamisado < setpoint + MARGEN_SOBRETEMP_C &&
         codigoFalla == FALLA_NINGUNA;
}

// Borra la memoria del controlador termico.
void reiniciarPID() {
  pidSalidaPct = 0.0f;
  pidIntegral = 0.0f;
  pidErrorAnterior = 0.0f;
  pidUltimoCalculoMs = 0;
}

// Apagado inmediato de resistencia y bomba.
// No cambia el estado del proceso ni apaga valvula o agitador.
// La logica posterior puede volver a habilitar cargas si sus permisos
// son verdaderos; esta funcion por si sola no enclava una falla.
void apagarCargasYa() {
  digitalWrite(PIN_RELAY_HEATER, SSR_HEATER_OFF);
  digitalWrite(PIN_LED_NIQUELINA, LOW);

  ledcWrite(PWM_CHANNEL, 0);
  digitalWrite(PIN_LED_BOMBA, LOW);

  salidaNiquelina = false;
  bombaFisicaActiva = false;
}

// ============================================================================
// 12. ALERTAS: EL CONTROL ENCOLA, LA RED PUBLICA
// ============================================================================

// El control no llama mqtt.publish().
// Solo coloca el mensaje en la cola para que lo publique tareaRed().
// Espera de cero ticks: no se bloquea si la cola esta llena.
// El retorno no se comprueba; una alerta puede perderse si no hay espacio.
void publicarAlerta(const char* tipo, const char* mensaje) {
  if (colaAlertas == NULL) return;

  Alerta alerta;

  strlcpy(alerta.tipo, tipo, sizeof(alerta.tipo));
  strlcpy(alerta.mensaje, mensaje, sizeof(alerta.mensaje));
  alerta.ts = millis();

  xQueueSend(colaAlertas, &alerta, 0);
}

