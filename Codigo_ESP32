enum EstadoSistema {
  EST_INIT,     // Esperando lecturas y condiciones para continuar.
  EST_NORMAL,   // Control normal, sujeto a todos los interbloqueos.
  EST_RELLENO,  // Espera previa o llenado activo.
  EST_FALLA     // Falla enclavada: necesita solicitud de rearme valida.
};

// Cada falla ocupa un bit diferente.
// Valor decimal:
// 0  = sin fallas.
// 1  = lectura de temperatura no disponible tras confirmaciones.
// 2  = lectura de nivel no disponible tras confirmaciones.
// 4  = sobretemperatura del pulmon.
// 8  = timeout de llenado.
// 16 = sobretemperatura del encamisado.
// Las fallas se pueden combinar:
// 9 = 8 + 1 = timeout de llenado y problema de temperatura.
// Operadores utilizados:
// |=  agrega una falla sin borrar las otras.
// &   comprueba si una falla esta presente.
// &= ~ elimina una falla sin borrar las otras.
enum Falla : uint8_t {
  FALLA_NINGUNA = 0,
  FALLA_SENSOR_TEMP = 1 << 0,
  FALLA_SENSOR_NIVEL = 1 << 1,
  FALLA_SOBRETEMP = 1 << 2,
  FALLA_TIMEOUT_LLENADO = 1 << 3,
  FALLA_SOBRETEMP_ENCAMISADO = 1 << 4
};

enum FaseBomba {
  BOMBA_ESPERANDO,        // Todavia no comenzo su primer periodo ON.
  BOMBA_ON,              // Periodo de funcionamiento.
  BOMBA_OFF,             // Pausa temporizada.
  BOMBA_PAUSA_SEGURIDAD   // Se perdio la solicitud o un permiso.
};

