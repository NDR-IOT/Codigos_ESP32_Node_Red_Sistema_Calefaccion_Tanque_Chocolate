// Avisos del proceso. No muestra diagnostico MQTT.
void mostrarPantallaAviso() {
  display.setCursor(0, 0);

  if (estado == EST_FALLA) {
    display.println("FALLA:");

    // Comprueba cada bit: puede mostrar mas de una causa.
    if (codigoFalla & FALLA_SOBRETEMP) {
      display.println("SOBRETEMP PULMON");
    }

    if (codigoFalla & FALLA_SOBRETEMP_ENCAMISADO) {
      display.println("SOBRETEMP ENCAM");
    }

    if (codigoFalla & FALLA_TIMEOUT_LLENADO) {
      display.println("TIMEOUT LLENADO");
    }

    return;
  }

  if (!nivelDisponible()) {
    display.println("NIVEL SIN LECTURA");
    display.println("Valvula: OFF");
    display.println("Bomba: OFF");
    display.println("Resistencia: OFF");
  } else if (!temperaturasDisponibles()) {
    display.println("SENSOR TEMP SIN");
    display.println("LECTURA");
  }
}

void actualizarOLED() {
  if (!oledDisponible) return;

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);

  bool hayAviso =
      estado == EST_FALLA ||
      !nivelDisponible() ||
      !temperaturasDisponibles();

  // Alterna normal/aviso en bloques de 3 segundos.
  bool mostrarAviso =
      hayAviso &&
      ((millis() / PANTALLA_AVISO_MS) % 2UL) == 1UL;

  if (mostrarAviso) {
    mostrarPantallaAviso();
  } else {
    mostrarPantallaOriginal();
  }

  display.display();
}

// ============================================================================
// 28. BUZZER
// ============================================================================

void actualizarBuzzer() {
  // En FALLA o sin nivel disponible, alterna cada 300 ms.
  if (estado == EST_FALLA || !nivelDisponible()) {
    bool encendido = ((millis() / 300UL) % 2UL) == 0;

    digitalWrite(PIN_BUZZER, encendido ? HIGH : LOW);
    return;
  }

  // Senal corta asociada a un comando reciente.
  // ultimoComandoMs inicia en cero, asi que esta expresion tambien
  // puede resultar verdadera al comienzo del arranque.
  digitalWrite(
      PIN_BUZZER,
      millis() - ultimoComandoMs < 150UL ? HIGH : LOW);
}

// ============================================================================
// 29. SETUP: SE EJECUTA UNA VEZ AL ARRANCAR
// ============================================================================

void setup() {
  // Primero configurar niveles de apagado y despues habilitar salidas.
  // Se repite el nivel apagado tras configurar cada pin.
  digitalWrite(PIN_RELAY_HEATER, SSR_HEATER_OFF);
  pinMode(PIN_RELAY_HEATER, OUTPUT);
  digitalWrite(PIN_RELAY_HEATER, SSR_HEATER_OFF);

  digitalWrite(PIN_RELAY_VALVE, RELAY_OFF);
  pinMode(PIN_RELAY_VALVE, OUTPUT);
  digitalWrite(PIN_RELAY_VALVE, RELAY_OFF);

  digitalWrite(PIN_RELAY_AGITADOR, RELAY_OFF);
  pinMode(PIN_RELAY_AGITADOR, OUTPUT);
  digitalWrite(PIN_RELAY_AGITADOR, RELAY_OFF);

  digitalWrite(PIN_PUMP_PWM, LOW);
  pinMode(PIN_PUMP_PWM, OUTPUT);
  digitalWrite(PIN_PUMP_PWM, LOW);

  // El monitor serial debe configurarse a 115200 baudios.
  Serial.begin(115200);
  Serial.println();

  Serial.println("Iniciando tanque de chocolate v3 - diagnostico");
  Serial.println("Red en nucleo 0, control en nucleo 1");
  Serial.println("Resumen del monitor serial cada 1 segundo");
  Serial.println("Bomba: 4 s de bloqueo inicial, luego 6 s ON / 2 s OFF");
  Serial.println("Valvula: espera automatica de 2 s");
  Serial.println("Cargas: 5 lecturas <= 4 cm y estables");
  Serial.println("OK_LOCAL no confirma recepcion en el dashboard");
  Serial.println();

  // Sensor de nivel e indicadores.
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);

  pinMode(PIN_LED_WIFI, OUTPUT);
  pinMode(PIN_LED_BOMBA, OUTPUT);
  pinMode(PIN_LED_NIQUELINA, OUTPUT);
  pinMode(PIN_LED_VALVULA, OUTPUT);
  pinMode(PIN_LED_AGITADOR, OUTPUT);
  pinMode(PIN_BUZZER, OUTPUT);

  digitalWrite(PIN_LED_WIFI, LOW);
  digitalWrite(PIN_LED_BOMBA, LOW);
  digitalWrite(PIN_LED_NIQUELINA, LOW);
  digitalWrite(PIN_LED_VALVULA, LOW);
  digitalWrite(PIN_LED_AGITADOR, LOW);
  digitalWrite(PIN_BUZZER, LOW);

  // PWM de bomba: conserva las llamadas de la version original.
  ledcSetup(PWM_CHANNEL, PWM_FREQ_HZ, PWM_RES_BITS);
  ledcAttachPin(PIN_PUMP_PWM, PWM_CHANNEL);
  ledcWrite(PWM_CHANNEL, 0);

  inicioBloqueoBombaMs = millis();

  // Recursos compartidos: se crean antes de iniciar tareaRed().
  colaAlertas = xQueueCreate(10, sizeof(Alerta));
  colaComandos = xQueueCreate(8, sizeof(ComandoRaw));
  mutexTelemetria = xSemaphoreCreateMutex();

  // Si faltan recursos indispensables, detener el arranque.
  if (colaAlertas == NULL ||
      colaComandos == NULL ||
      mutexTelemetria == NULL) {
    Serial.println(
        "[ERROR INIT] No se pudieron crear colas o mutex. Cargas apagadas.");

    apagarCargasYa();

    for (;;) {
      delay(1000);
    }
  }

  // Pantalla OLED. Si no inicia, el programa continua sin pantalla.
  Wire.begin(PIN_OLED_SDA, PIN_OLED_SCL);

  oledDisponible = display.begin(SSD1306_SWITCHCAPVCC, 0x3C);

  if (oledDisponible) {
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(1);
    display.setCursor(0, 0);
    display.println("Tanque chocolate");
    display.println("Iniciando...");
    display.display();
  }

  // Inicializa buses y configura conversiones sin esperar en la solicitud.
  sensorsPulmon.begin();
  sensorsEncamisado.begin();

  sensorsPulmon.setWaitForConversion(false);
  sensorsEncamisado.setWaitForConversion(false);

  // Selecciona el primer sensor encontrado en cada bus.
  // La busqueda se hace aqui al arrancar, no continuamente en loop().
  sensorPulmonEncontrado =
      sensorsPulmon.getDeviceCount() >= 1 &&
      sensorsPulmon.getAddress(dirPulmon, 0);

  sensorEncamisadoEncontrado =
      sensorsEncamisado.getDeviceCount() >= 1 &&
      sensorsEncamisado.getAddress(dirEncamisado, 0);

  if (sensorPulmonEncontrado) {
    Serial.print("DS18B20 pulmon: ");
    imprimirDireccion(dirPulmon);
  } else {
    Serial.println("Falta DS18B20 pulmon");
  }

  if (sensorEncamisadoEncontrado) {
    Serial.print("DS18B20 encamisado: ");
    imprimirDireccion(dirEncamisado);
  } else {
    Serial.println("Falta DS18B20 encamisado");
  }

  // Identificador MQTT basado en el chip.
  uint64_t chipId = ESP.getEfuseMac();

  snprintf(
      mqttClientId,
      sizeof(mqttClientId),
      "esp32-choco-%04X%08X",
      (uint16_t)(chipId >> 32),
      (uint32_t)chipId);

  mqtt.setServer(MQTT_SERVER, MQTT_PORT);
  mqtt.setCallback(alRecibirMensaje);

  // Buffer MQTT para alojar contenido y cabecera del mensaje.
  if (!mqtt.setBufferSize(768)) {
    Serial.println(
        "[AVISO MQTT] No se pudo ampliar el buffer a 768 bytes");
  }

  // Timeout de socket y mantenimiento de sesion.
  // No deben interpretarse como un limite total de toda operacion de red.
  mqtt.setSocketTimeout(3);
  mqtt.setKeepAlive(30);

  // WiFi en modo cliente.
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS);

  ultimoWiFiIntentoMs = millis();

  estado = EST_INIT;

  // Tarea de red fijada al nucleo 0 y con prioridad 1.
  BaseType_t resultadoTarea = xTaskCreatePinnedToCore(
      tareaRed,
      "tareaRed",
      10240,
      NULL,
      1,
      &tareaRedHandle,
      0);

  // Si no se crea la tarea, el control continua,
  // pero no habra publicaciones ni recepcion de comandos.
  if (resultadoTarea != pdPASS) {
    Serial.println(
        "[ERROR RED] No se pudo crear la tarea de red");
  }

  // Watchdog del lazo principal: conserva la API del programa original.
  // Los retornos no se comprueban en esta version.
  // tareaRed() no se registra explicitamente aqui en el watchdog.
  esp_task_wdt_init(WDT_TIMEOUT_S, true);
  esp_task_wdt_add(NULL);

  ultimaIteracionMs = millis();
  ultimoSerialMs = millis();
}

// ============================================================================
// 30. LOOP: CONTROL CONTINUO DEL TANQUE
// ============================================================================

void loop() {
  // Informa al watchdog que el lazo principal sigue ejecutandose.
  esp_task_wdt_reset();

  unsigned long ahora = millis();

  // Detecta una vuelta anterior demasiado lenta y ejecuta corte inmediato.
  // No enclava FALLA; mas abajo se reevaluan y aplican salidas.
  if (ahora - ultimaIteracionMs > LAZO_MAX_MS) {
    apagarCargasYa();

    Serial.println(
        "AVISO: lazo de control lento, cargas apagadas");
  }

  ultimaIteracionMs = ahora;

  // Entradas: comandos, temperaturas y nivel.
  procesarComandos();
  leerTemperaturas();
  leerNivel();

  ahora = millis();

  // Decisiones de control aproximadamente cada 250 ms.
  // El orden es importante:
  // 1. Fallas y seguridad.
  // 2. Estado del proceso.
  // 3. Ordenes de actuadores.
  if (ahora - ultimoControlMs >= CONTROL_MS) {
    ultimoControlMs = ahora;

    evaluarSeguridad();
    actualizarMaquinaEstados();
    aplicarControl();
  }

  // Comprobacion general de cargas en cada vuelta.
  if (!cargasPermitidasAhora()) {
    apagarCargasYa();
  }

  // Estas funciones vuelven a comprobar sus permisos antes de aplicar salidas.
  actualizarSalidaBomba();
  actualizarSalidaHeater();
  actualizarBuzzer();

  // El LED WiFi solo indica conexion WiFi, no MQTT ni recepcion del dashboard.
  digitalWrite(
      PIN_LED_WIFI,
      WiFi.status() == WL_CONNECTED ? HIGH : LOW);

  // Actualizacion de pantalla aproximadamente cada segundo.
  if (ahora - ultimoOledMs >= OLED_MS) {
    ultimoOledMs = ahora;
    actualizarOLED();
  }

  ahora = millis();

  // Preparar una nueva muestra aproximadamente cada segundo.
  // La tarea de red la publicara cuando pueda procesarla.
  if (ahora - ultimaTelemetriaMs >= TELEMETRIA_MS) {
    ultimaTelemetriaMs = ahora;
    prepararTelemetria();
  }

  ahora = millis();

  // Resumen serial aproximadamente cada segundo.
  // Los eventos de conexion, arranque y seguridad pueden imprimirse aparte.
  if (ahora - ultimoSerialMs >= SERIAL_MS) {
    ultimoSerialMs = ahora;
    imprimirDiagnosticoSerial();
  }

  // Pausa breve. No se utiliza delay(1000) en el funcionamiento normal.
  delay(1);
}
