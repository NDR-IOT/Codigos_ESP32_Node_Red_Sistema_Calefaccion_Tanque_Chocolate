// La conversion se solicita en una vuelta y se recoge en otra.
// Durante la espera de 800 ms se sigue ejecutando el resto del control.
void leerTemperaturas() {
  static bool conversionPendiente = false;
  static unsigned long inicioConversionMs = 0;

  // Primera etapa: solicitar nuevas conversiones.
  if (!conversionPendiente) {
    if (sensorPulmonEncontrado) {
      sensorsPulmon.requestTemperatures();
    }

    if (sensorEncamisadoEncontrado) {
      sensorsEncamisado.requestTemperatures();
    }

    conversionPendiente = true;
    inicioConversionMs = millis();
    return;
  }

  // Todavia no corresponde recoger el resultado.
  if (millis() - inicioConversionMs < 800UL) return;

  conversionPendiente = false;

  // Validacion y actualizacion del pulmon.
  if (sensorPulmonEncontrado) {
    float lectura = sensorsPulmon.getTempC(dirPulmon);

    tempPulmonValida =
        lectura != DEVICE_DISCONNECTED_C &&
        lectura > -50.0f &&
        lectura < 120.0f;

    if (tempPulmonValida) {
      tempPulmon = lectura;
      ultimaTempPulmonValidaMs = millis();
    }
  } else {
    tempPulmonValida = false;
  }

  // Validacion y actualizacion del encamisado.
  if (sensorEncamisadoEncontrado) {
    float lectura = sensorsEncamisado.getTempC(dirEncamisado);

    tempEncamisadoValida =
        lectura != DEVICE_DISCONNECTED_C &&
        lectura > -50.0f &&
        lectura < 120.0f;

    if (tempEncamisadoValida) {
      tempEncamisado = lectura;
      ultimaTempEncamisadoValidaMs = millis();
    }
  } else {
    tempEncamisadoValida = false;
  }

  // Se cuenta una evaluacion invalida por conversion recogida.
  if (temperaturasDisponibles()) {
    contadorTempInvalida = 0;
  } else {
    contadorTempInvalida++;
  }
}

// ============================================================================
// 14. LECTURA DE NIVEL
// ============================================================================

void leerNivel() {
  // Una medicion como maximo cada 250 ms.
  if (millis() - ultimaLecturaNivelMs < LECTURA_NIVEL_MS) return;

  ultimaLecturaNivelMs = millis();

  // Pulso de disparo del ultrasonico.
  digitalWrite(PIN_TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(PIN_TRIG, HIGH);
  delayMicroseconds(10);

  digitalWrite(PIN_TRIG, LOW);

  // Espera el pulso ECHO hasta 30000 microsegundos.
  // Esta llamada puede bloquear brevemente, hasta ese limite.
  unsigned long duracion = pulseIn(PIN_ECHO, HIGH, 30000UL);

  // Conversion usada por este programa: microsegundos a centimetros.
  float distancia = duracion / 58.0f;

  // Sin eco o fuera de rango: invalida la lectura y pierde confirmaciones.
  if (duracion == 0 || distancia < 2.0f || distancia > 400.0f) {
    nivelValida = false;
    contadorNivelSeguro = 0;
    contadorNivelBajo = 0;
    contadorNivelInvalido++;
    nivelMuestrasN = 0;
    return;
  }

  nivelCm = distancia;
  nivelValida = true;
  ultimoNivelValidoMs = millis();
  contadorNivelInvalido = 0;

  // Guarda la medicion en una ventana circular.
  nivelMuestras[nivelMuestrasIdx] = distancia;
  nivelMuestrasIdx = (nivelMuestrasIdx + 1) % NIVEL_MUESTRAS;

  if (nivelMuestrasN < NIVEL_MUESTRAS) {
    nivelMuestrasN++;
  }

  // Una sola lectura > 4 cm elimina las confirmaciones de nivel seguro.
  if (nivelCm <= DISTANCIA_MAX_CARGAS_CM) {
    if (contadorNivelSeguro < NIVEL_CONFIRMACIONES_CARGAS) {
      contadorNivelSeguro++;
    }
  } else {
    contadorNivelSeguro = 0;
  }
}

// ============================================================================
// 15. EVALUACION DE SEGURIDAD Y FALLAS
// ============================================================================

void evaluarSeguridad() {
  // Falla de temperatura: se registra tras varias evaluaciones invalidas.
  // El permiso de cargas puede perderse antes de alcanzar este contador.
  if (!temperaturasDisponibles() && contadorTempInvalida >= DEBOUNCE) {
    fallaLatente |= FALLA_SENSOR_TEMP;

    if (!(fallasAlertadas & FALLA_SENSOR_TEMP)) {
      publicarAlerta("SENSOR_TEMP_INVALIDO", "DS18B20 sin lectura valida");
      fallasAlertadas |= FALLA_SENSOR_TEMP;
    }
  } else if (temperaturasDisponibles()) {
    // Esta falla se borra cuando las temperaturas vuelven a estar disponibles.
    fallaLatente &= ~FALLA_SENSOR_TEMP;
    fallasAlertadas &= ~FALLA_SENSOR_TEMP;
  }

  // Falla de nivel: se registra tras varias lecturas invalidas.
  if (!nivelDisponible() && contadorNivelInvalido >= DEBOUNCE) {
    fallaLatente |= FALLA_SENSOR_NIVEL;
  } else if (nivelDisponible()) {
    fallaLatente &= ~FALLA_SENSOR_NIVEL;
  }

  // Sobretemperatura y desviacion: se evalua con ambos sensores disponibles.
  if (temperaturasDisponibles()) {
    float corte = setpoint + MARGEN_SOBRETEMP_C;

    if (tempPulmon >= corte) {
      fallaLatente |= FALLA_SOBRETEMP;

      if (!(fallasAlertadas & FALLA_SOBRETEMP)) {
        publicarAlerta("SOBRETEMPERATURA", "Pulmon por encima del corte");
        fallasAlertadas |= FALLA_SOBRETEMP;
      }
    }

    if (tempEncamisado >= corte) {
      fallaLatente |= FALLA_SOBRETEMP_ENCAMISADO;

      if (!(fallasAlertadas & FALLA_SOBRETEMP_ENCAMISADO)) {
        publicarAlerta(
            "SOBRETEMPERATURA_ENCAMISADO",
            "Encamisado por encima del corte");

        fallasAlertadas |= FALLA_SOBRETEMP_ENCAMISADO;
      }
    }

    // Desviacion no significa necesariamente sobretemperatura.
    // fabsf() toma el valor absoluto: tambien alerta si esta muy frio.
    // Esta alerta no agrega por si misma un bit a codigoFalla.
    bool desviacion = fabsf(tempPulmon - setpoint) >= MARGEN_SOBRETEMP_C;

    if (desviacion && !desviacionAlertada) {
      publicarAlerta("DESVIACION_TERMICA", "Desviacion termica del setpoint");
      desviacionAlertada = true;
    } else if (!desviacion) {
      desviacionAlertada = false;
    }
  }

  codigoFalla = fallaLatente;

  // Solo estas fallas fuerzan el estado enclavado EST_FALLA.
  // Las fallas de sensores afectan disponibilidad y permisos,
  // pero no aparecen en este conjunto de fallas que enclavan.
  const uint8_t fallasQueEnclavan =
      FALLA_SOBRETEMP |
      FALLA_SOBRETEMP_ENCAMISADO |
      FALLA_TIMEOUT_LLENADO;

  if (codigoFalla & fallasQueEnclavan) {
    estado = EST_FALLA;
  }
}

// ============================================================================
// 16. MAQUINA DE ESTADOS Y LLENADO
// ============================================================================

// Cancela los temporizadores y la marca logica de llenado.
// La orden del pin de valvula se actualiza despues en aplicarControl().
void cancelarLlenado() {
  inicioEsperaValvulaMs = 0;
  inicioLlenadoMs = 0;
  llenadoActivo = false;
  contadorNivelBajo = 0;
}

void actualizarMaquinaEstados() {
  // En FALLA solo se permite avanzar con una solicitud de reset
  // y las condiciones de rearme indicadas.
  // El rearme exige nivel disponible, pero no exige que ya sea <= 4 cm.
  if (estado == EST_FALLA) {
    if (solicitudReset &&
        temperaturasDisponibles() &&
        nivelDisponible() &&
        tempPulmon < setpoint + MARGEN_REARME_C &&
        tempEncamisado < setpoint + MARGEN_REARME_C) {
      solicitudReset = false;
      fallaLatente = FALLA_NINGUNA;
      codigoFalla = FALLA_NINGUNA;
      fallasAlertadas = FALLA_NINGUNA;

      cancelarLlenado();
      reiniciarPID();

      estado = EST_INIT;
    }

    return;
  }

  // Fuera de FALLA, perder disponibilidad de sensores vuelve a INIT.
  if (!temperaturasDisponibles() || !nivelDisponible()) {
    cancelarLlenado();
    reiniciarPID();

    estado = EST_INIT;
    return;
  }

  switch (estado) {
    case EST_INIT:
      // Entrar en NORMAL usa tres confirmaciones.
      // El permiso de cargas sigue exigiendo cinco y estabilidad.
      if (contadorNivelSeguro >= DEBOUNCE) {
        estado = EST_NORMAL;
      } else if (nivelCm > DISTANCIA_INICIO_LLENADO_CM) {
        // Este contador se incrementa al evaluar la maquina de estados.
        if (contadorNivelBajo < DEBOUNCE) {
          contadorNivelBajo++;
        }

        if (contadorNivelBajo >= DEBOUNCE) {
          estado = EST_RELLENO;
          inicioEsperaValvulaMs = millis();
        }
      }
      break;

    case EST_NORMAL:
      // Distancia grande: iniciar secuencia de llenado tras confirmaciones.
      if (nivelCm > DISTANCIA_INICIO_LLENADO_CM) {
        if (contadorNivelBajo < DEBOUNCE) {
          contadorNivelBajo++;
        }

        if (contadorNivelBajo >= DEBOUNCE) {
          estado = EST_RELLENO;
          inicioEsperaValvulaMs = millis();

          publicarAlerta(
              "NIVEL_BAJO",
              "Esperando retorno antes de llenar");
        }
      } else {
        contadorNivelBajo = 0;
      }
      break;

    case EST_RELLENO:
      // Si el nivel se recupera durante la espera previa, no iniciar llenado.
      if (!llenadoActivo &&
          nivelCm <= DISTANCIA_INICIO_LLENADO_CM) {
        cancelarLlenado();
        estado = EST_NORMAL;
        break;
      }

      // Un llenado activo termina al alcanzar distancia <= 3 cm.
      if (llenadoActivo &&
          nivelCm <= DISTANCIA_FIN_LLENADO_CM) {
        cancelarLlenado();
        estado = EST_NORMAL;

        publicarAlerta(
            "NIVEL_NORMAL",
            "Nivel de llenado alcanzado");

        break;
      }

      // Tras los 2 segundos de espera, comienza el temporizador de llenado.
      if (!llenadoActivo &&
          millis() - inicioEsperaValvulaMs >= ESPERA_VALVULA_MS) {
        llenadoActivo = true;
        inicioLlenadoMs = millis();
      }

      // Si no alcanza el nivel final dentro de 60 segundos, enclava FALLA.
      // Esta maquina se ejecuta tambien en modo manual.
      // El temporizador representa llenadoActivo, no una confirmacion
      // de que la valvula se haya abierto fisicamente.
      if (llenadoActivo &&
          millis() - inicioLlenadoMs >= TIMEOUT_LLENADO_MS) {
        cancelarLlenado();

        fallaLatente |= FALLA_TIMEOUT_LLENADO;
        codigoFalla = fallaLatente;
        estado = EST_FALLA;

        publicarAlerta(
            "TIMEOUT_LLENADO",
            "No alcanzo nivel en 60 s");
      }
      break;

    case EST_FALLA:
      // El manejo de FALLA esta al principio de esta funcion.
      break;
  }
}

// ============================================================================
// 17. CONTROLADOR PID DE TEMPERATURA
// ============================================================================

float calcularPID(float referencia, float medida) {
  unsigned long ahora = millis();

  // Tiempo real entre calculos.
// En el primer calculo se utiliza 1 segundo como valor inicial.
  float intervaloSegundos =
      pidUltimoCalculoMs == 0
          ? 1.0f
          : (ahora - pidUltimoCalculoMs) / 1000.0f;

  if (intervaloSegundos <= 0.0f || intervaloSegundos > 5.0f) {
    intervaloSegundos = 1.0f;
  }

  pidUltimoCalculoMs = ahora;

  // Error positivo: temperatura por debajo de la referencia.
  float error = referencia - medida;

  // Acumulacion del error, limitada para restringir el crecimiento integral.
  pidIntegral += error * intervaloSegundos;
  pidIntegral = constrain(pidIntegral, -50.0f, 50.0f);

  // Cambio del error respecto del calculo anterior.
  float derivada = (error - pidErrorAnterior) / intervaloSegundos;
  pidErrorAnterior = error;

  float salida =
      Kp * error +
      Ki * pidIntegral +
      Kd * derivada;

  // El PID entrega un porcentaje; no activa directamente la resistencia.
  return limitar(salida, 0.0f, 100.0f);
}

// ============================================================================
// 18. SECUENCIA TEMPORIZADA DE LA BOMBA
// ============================================================================

// Devuelve true solamente durante un periodo ON permitido.
bool bombaEnTiempo(bool solicitudBomba) {
  unsigned long ahora = millis();

  if (ahora - inicioBloqueoBombaMs < BOMBA_BLOQUEO_INICIAL_MS) {
    return false;
  }

  // Sin solicitud o con porcentaje cero, no aplicar potencia.
  if (!solicitudBomba || velocidadBombaPct <= 0.0f) {
    if (faseBomba == BOMBA_ON || faseBomba == BOMBA_OFF) {
      faseBomba = BOMBA_PAUSA_SEGURIDAD;
    }

    return false;
  }

  if (faseBomba == BOMBA_ESPERANDO) {
    // Primer arranque permitido.
    faseBomba = BOMBA_ON;
    inicioFaseBombaMs = ahora;
  } else if (faseBomba == BOMBA_PAUSA_SEGURIDAD) {
    // Al recuperar permiso despues de una pausa, primero espera 2 segundos.
    faseBomba = BOMBA_OFF;
    inicioFaseBombaMs = ahora;
  } else if (faseBomba == BOMBA_ON &&
             ahora - inicioFaseBombaMs >= BOMBA_ON_MS) {
    faseBomba = BOMBA_OFF;
    inicioFaseBombaMs = ahora;
  } else if (faseBomba == BOMBA_OFF &&
             ahora - inicioFaseBombaMs >= BOMBA_OFF_MS) {
    faseBomba = BOMBA_ON;
    inicioFaseBombaMs = ahora;
  }

  return faseBomba == BOMBA_ON;
}

// ============================================================================
// 19. DECISION DE ORDENES Y APLICACION DE VALVULA/AGITADOR
// ============================================================================

void aplicarControl() {
  // Cada ciclo comienza con solicitudes apagadas.
  cmdBomba = false;
  cmdValvula = false;
  cmdNiquelina = false;
  cmdAgitador = false;
  pidSalidaPct = 0.0f;

  bool temperaturasOK = temperaturasDisponibles();
  bool nivelSeguro = nivelConfirmadoParaCargas();

  // Solicitudes base de bomba y resistencia, solo en NORMAL.
  if (estado == EST_NORMAL) {
    if (modoManual) {
      cmdBomba = manualBombaCmd;
      cmdNiquelina = manualHeaterCmd;
    } else {
      cmdBomba = true;
      cmdNiquelina = true;
    }
  }

  // Valvula manual: solicitud y seguridad adicional.
  // Valvula automatica: estado RELLENO, llenado activo y nivel por recuperar.
  if (modoManual) {
    cmdValvula =
        manualValvulaCmd &&
        seguridadValvulaManual();
  } else {
    cmdValvula =
        estado == EST_RELLENO &&
        llenadoActivo &&
        nivelDisponible() &&
        nivelCm > DISTANCIA_FIN_LLENADO_CM;
  }

  // Permiso comun de bomba y resistencia.
  bool cargasPermitidas =
      estado == EST_NORMAL &&
      temperaturasOK &&
      nivelSeguro &&
      !cmdValvula &&
      estado != EST_FALLA;

  // Bomba: ademas requiere temperatura minima del pulmon.
  cmdBomba =
      cmdBomba &&
      cargasPermitidas &&
      tempPulmon >= TEMP_MIN_BOMBA_C;

  cmdNiquelina =
      cmdNiquelina &&
      cargasPermitidas;

  // En automatico el agitador se solicita por defecto.
  // En manual requiere su orden, pero conserva la histeresis termica.
  bool agitadorSolicitado = !modoManual || manualAgitadorCmd;

  if ((estado != EST_NORMAL && estado != EST_RELLENO) ||
      !encamisadoDisponible() ||
      !agitadorSolicitado ||
      estado == EST_FALLA) {
    agitadorHabilitado = false;
  } else if (tempEncamisado >= AGITADOR_ENCIENDE_C) {
    agitadorHabilitado = true;
  } else if (tempEncamisado <= AGITADOR_APAGA_C) {
    agitadorHabilitado = false;
  }

  cmdAgitador = agitadorHabilitado;

  // Resistencia manual permitida: solicita 100%.
  // Resistencia automatica permitida: utiliza el PID.
  if (cmdNiquelina) {
    if (modoManual) {
      pidSalidaPct = 100.0f;
      pidIntegral = 0.0f;
      pidUltimoCalculoMs = 0;
    } else {
      pidSalidaPct = calcularPID(setpoint, tempPulmon);
    }
  } else {
    reiniciarPID();
  }

  // Estas salidas se actualizan en el ciclo de control de 250 ms.
  setRelay(PIN_RELAY_VALVE, cmdValvula);
  setRelay(PIN_RELAY_AGITADOR, cmdAgitador);

  digitalWrite(PIN_LED_VALVULA, cmdValvula ? HIGH : LOW);
  digitalWrite(PIN_LED_AGITADOR, cmdAgitador ? HIGH : LOW);
}

// ============================================================================
// 20. SALIDAS DE BOMBA Y RESISTENCIA: CADA VUELTA DEL LOOP
// ============================================================================

void actualizarSalidaBomba() {
  // Vuelve a comprobar permisos antes de aplicar PWM.
  bool habilitada =
      cmdBomba &&
      estado == EST_NORMAL &&
      temperaturasDisponibles() &&
      nivelConfirmadoParaCargas() &&
      tempPulmon >= TEMP_MIN_BOMBA_C &&
      !cmdValvula &&
      estado != EST_FALLA;

  bombaFisicaActiva = bombaEnTiempo(habilitada);

  // Convierte porcentaje a rango de 8 bits: 0..255.
  int duty =
      bombaFisicaActiva
          ? (int)roundf(velocidadBombaPct * 255.0f / 100.0f)
          : 0;

  ledcWrite(PWM_CHANNEL, constrain(duty, 0, 255));
  digitalWrite(PIN_LED_BOMBA, bombaFisicaActiva ? HIGH : LOW);
}

void actualizarSalidaHeater() {
  unsigned long ahora = millis();

  // Inicia una ventana nueva cuando termina la anterior.
  if (ahora - inicioVentanaPwmMs >= PWM_TERMICO_MS) {
    inicioVentanaPwmMs = ahora;
  }

  // Tiempo ON solicitado dentro de la ventana termica.
  unsigned long tiempoOn =
      (unsigned long)(PWM_TERMICO_MS * pidSalidaPct / 100.0f);

  // Verificacion adicional de permisos y limites de temperatura.
  bool habilitada =
      cmdNiquelina &&
      estado == EST_NORMAL &&
      temperaturasDisponibles() &&
      nivelConfirmadoParaCargas() &&
      tempPulmon < setpoint + MARGEN_SOBRETEMP_C &&
      tempEncamisado < setpoint + MARGEN_SOBRETEMP_C &&
      !cmdValvula &&
      estado != EST_FALLA;

  salidaNiquelina =
      habilitada &&
      ahora - inicioVentanaPwmMs < tiempoOn;

  digitalWrite(
      PIN_RELAY_HEATER,
      salidaNiquelina ? SSR_HEATER_ON : SSR_HEATER_OFF);

  digitalWrite(
      PIN_LED_NIQUELINA,
      salidaNiquelina ? HIGH : LOW);
}

// Comprobacion general que utiliza loop() para el apagado inmediato.
bool cargasPermitidasAhora() {
  return estado == EST_NORMAL &&
         temperaturasDisponibles() &&
         nivelConfirmadoParaCargas() &&
         !cmdValvula;
}

// ============================================================================
// 21. PREPARACION DE TELEMETRIA
// ============================================================================

// Construye el JSON y lo deja disponible para la tarea de red.
// Esta funcion no publica directamente por MQTT.
void prepararTelemetria() {
  char payload[700];

  // Los nombres de campos forman el contrato con quien recibe los datos.
  // Si un sensor no esta disponible se transmite 0 en su valor.
  // Quien lo recibe debe consultar tambien las banderas de validez.
  // temp_valida representa la disponibilidad de AMBOS sensores.
  int longitud = snprintf(
      payload, sizeof(payload),
      "{\"estado\":\"%s\","
      "\"temp_pulmon\":%.2f,"
      "\"temp_encamisado\":%.2f,"
      "\"nivel_cm\":%.1f,"
      "\"pid_pct\":%.1f,"
      "\"setpoint\":%.1f,"
      "\"modo_manual\":%s,"
      "\"bomba\":%s,"
      "\"velocidad_bomba\":%.0f,"
      "\"valvula\":%s,"
      "\"agitador\":%s,"
      "\"niquelina\":%s,"
      "\"kp\":%.2f,"
      "\"ki\":%.2f,"
      "\"kd\":%.2f,"
      "\"temp_valida\":%s,"
      "\"nivel_valida\":%s,"
      "\"cargas_ok\":%s,"
      "\"codigo_falla\":%u}",
      nombreEstado(),
      pulmonDisponible() ? tempPulmon : 0.0f,
      encamisadoDisponible() ? tempEncamisado : 0.0f,
      nivelDisponible() ? nivelCm : 0.0f,
      pidSalidaPct,
      setpoint,
      modoManual ? "true" : "false",
      bombaFisicaActiva ? "true" : "false",
      velocidadBombaPct,
      cmdValvula ? "true" : "false",
      cmdAgitador ? "true" : "false",
      salidaNiquelina ? "true" : "false",
      Kp,
      Ki,
      Kd,
      temperaturasDisponibles() ? "true" : "false",
      nivelDisponible() ? "true" : "false",
      nivelConfirmadoParaCargas() ? "true" : "false",
      (unsigned int)codigoFalla);

  ultimaTelemetriaPreparada = false;
  resultadoPreparacion = "MUTEX_OCUPADO";

  // No permitir un JSON truncado por falta de espacio.
  if (longitud < 0 || (size_t)longitud >= sizeof(payload)) {
    resultadoPreparacion = "ERROR_TAMANO_JSON";
    return;
  }

  if (mutexTelemetria == NULL) {
    resultadoPreparacion = "SIN_MUTEX";
    return;
  }

  // Espera breve para acceder al buffer sin frenar demasiado el control.
  if (xSemaphoreTake(mutexTelemetria, pdMS_TO_TICKS(5)) == pdTRUE) {
    strlcpy(
        telemetriaCompartida,
        payload,
        sizeof(telemetriaCompartida));

    telemetriaLista = true;
    ultimaTelemetriaPreparada = true;
    resultadoPreparacion = "OK";

    xSemaphoreGive(mutexTelemetria);
  }
}

// ============================================================================
// 22. DIAGNOSTICO DEL MONITOR SERIAL
// ============================================================================

// loop() llama esta funcion aproximadamente una vez por segundo.
// PROCESO: mediciones y estado actual del control.
// RED: ultima conexion observada por tareaRed().
// DATOS: preparacion actual y ultimo resultado de publicacion.
// ENVIOS: contador de publicaciones exitosas locales.
// TIEMPOS: antiguedad del ultimo envio y del diagnostico de red.
// La muestra recien preparada y el ultimo envio terminado pueden ser distintos.
void imprimirDiagnosticoSerial() {
  DiagnosticoRed resumen;

  // Obtiene una copia consistente sin imprimir dentro de la seccion critica.
  portENTER_CRITICAL(&mutexDiagnostico);
  resumen = diagnosticoCompartido;
  portEXIT_CRITICAL(&mutexDiagnostico);

  unsigned long ahora = millis();
  unsigned long edadRed = ahora - resumen.actividadMs;

  char edadEnvio[24];

  if (resumen.enviados == 0) {
    strlcpy(edadEnvio, "NUNCA", sizeof(edadEnvio));
  } else {
    snprintf(
        edadEnvio,
        sizeof(edadEnvio),
        "%lu ms",
        ahora - resumen.ultimoEnvioMs);
  }

  // tarea_red=OK solo significa diagnostico reciente.
  // No garantiza WiFi, MQTT ni recepcion del dashboard.
  const char* actividadRed =
      !resumen.activa
          ? "SIN_ACTIVIDAD"
          : (edadRed > 5000UL ? "REVISAR" : "OK");

  // -99 y -1 son marcadores de no disponibilidad en el serial.
  // No representan temperaturas o distancias reales.
  // falla muestra solo el numero; su significado esta documentado
  // en enum Falla. No se imprime una descripcion textual aqui.
  Serial.printf(
      "[PROCESO] estado=%s falla=%u "
      "pulmon=%.1f encam=%.1f nivel=%.1f "
      "cargasOK=%d heater=%d bomba=%d valvula=%d manual=%d\n"
      "   [RED] WIFI=%s | MQTT=%s\n"
      "   [DATOS] preparada=%s preparacion=%s ultimo_resultado=%s\n"
      "   [ENVIOS] OK=%lu\n"
      "   [TIEMPOS] ultimo_OK_hace=%s "
      "actividad_red_hace=%lu ms tarea_red=%s\n",
      nombreEstado(),
      (unsigned int)codigoFalla,
      pulmonDisponible() ? tempPulmon : -99.0f,
      encamisadoDisponible() ? tempEncamisado : -99.0f,
      nivelDisponible() ? nivelCm : -1.0f,
      nivelConfirmadoParaCargas() ? 1 : 0,
      salidaNiquelina ? 1 : 0,
      bombaFisicaActiva ? 1 : 0,
      cmdValvula ? 1 : 0,
      modoManual ? 1 : 0,
      resumen.wifi ? "CONECTADO" : "DESCONECTADO",
      resumen.mqtt ? "CONECTADO" : "DESCONECTADO",
      ultimaTelemetriaPreparada ? "SI" : "NO",
      resultadoPreparacion,
      resumen.resultado,
      resumen.enviados,
      edadEnvio,
      edadRed,
      actividadRed);

  // Muestra un aviso prioritario, no todos simultaneamente.
  // Si el diagnostico envejece, WiFi/MQTT pueden ser datos antiguos.
  if (!resumen.activa) {
    Serial.println("   [AVISO] La tarea de red aun no reporta actividad");
  } else if (edadRed > 5000UL) {
    Serial.println("   [AVISO] Diagnostico de red antiguo: revisar tarea de red");
  } else if (!resumen.wifi) {
    Serial.println("   [AVISO] Sin conexion WiFi");
  } else if (!resumen.mqtt) {
    Serial.println("   [AVISO] Sin conexion MQTT");
  } else if (strcmp(resumen.resultado, "ERROR_PUBLICACION") == 0) {
    Serial.println("   [AVISO] Fallo el ultimo intento de publicar telemetria");
  }

  Serial.println();
}

// ============================================================================
// 23. INTERPRETACION DE COMANDOS MQTT EN EL CONTROL
// ============================================================================

// Ejemplos del formato esperado:
// {"cmd":"setpoint","valor":48}
// {"cmd":"modo","valor":"manual"}
// {"cmd":"modo","valor":"automatico"}
// {"cmd":"bomba","valor":true}
// {"cmd":"valvula","valor":false}
// {"cmd":"niquelina","valor":true}
// {"cmd":"agitador","valor":true}
// {"cmd":"velocidad_bomba","valor":60}
// {"cmd":"pid","kp":25,"ki":0.8,"kd":5}
// {"cmd":"reset_falla"}
// Los comandos de actuadores guardan solicitudes.
// Sus permisos y aplicacion se deciden posteriormente en el control.
void ejecutarComando(const char* texto) {
  StaticJsonDocument<384> doc;

  DeserializationError error = deserializeJson(doc, texto);

  if (error) {
    publicarAlerta("COMANDO_INVALIDO", "JSON mal formado");
    return;
  }

  const char* comando = doc["cmd"];

  if (!comando) return;

  // Marca recepcion de un JSON con campo cmd, aunque el comando sea desconocido.
  ultimoComandoMs = millis();

  if (strcmp(comando, "setpoint") == 0 &&
      doc.containsKey("valor")) {
    setpoint = limitar(
        doc["valor"].as<float>(),
        SETPOINT_MIN,
        SETPOINT_MAX);

    reiniciarPID();
  } else if (strcmp(comando, "modo") == 0 &&
             doc.containsKey("valor")) {
    const char* valor = doc["valor"];

    // Solo el texto exacto "manual" activa el modo manual.
    modoManual = valor && strcmp(valor, "manual") == 0;

    if (!modoManual) {
      manualBombaCmd = false;
      manualValvulaCmd = false;
      manualHeaterCmd = false;
      manualAgitadorCmd = false;
    }

    reiniciarPID();
  } else if (strcmp(comando, "bomba") == 0 &&
             doc.containsKey("valor")) {
    manualBombaCmd = doc["valor"].as<bool>();
  } else if (strcmp(comando, "valvula") == 0 &&
             doc.containsKey("valor")) {
    manualValvulaCmd = doc["valor"].as<bool>();
  } else if (strcmp(comando, "niquelina") == 0 &&
             doc.containsKey("valor")) {
    manualHeaterCmd = doc["valor"].as<bool>();
  } else if (strcmp(comando, "agitador") == 0 &&
             doc.containsKey("valor")) {
    manualAgitadorCmd = doc["valor"].as<bool>();
  } else if (strcmp(comando, "velocidad_bomba") == 0 &&
             doc.containsKey("valor")) {
    velocidadBombaPct = limitar(
        doc["valor"].as<float>(),
        BOMBA_MIN_PCT,
        BOMBA_MAX_PCT);
  } else if (strcmp(comando, "pid") == 0) {
    if (doc.containsKey("kp")) {
      Kp = limitar(doc["kp"].as<float>(), KP_MIN, KP_MAX);
    }

    if (doc.containsKey("ki")) {
      Ki = limitar(doc["ki"].as<float>(), KI_MIN, KI_MAX);
    }

    if (doc.containsKey("kd")) {
      Kd = limitar(doc["kd"].as<float>(), KD_MIN, KD_MAX);
    }

    reiniciarPID();
  } else if (strcmp(comando, "reset_falla") == 0) {
    // Solicita rearme; no cambia directamente el estado.
    // actualizarMaquinaEstados() vuelve a comprobar las condiciones.
    if (temperaturasDisponibles() &&
        nivelDisponible() &&
        tempPulmon < setpoint + MARGEN_REARME_C &&
        tempEncamisado < setpoint + MARGEN_REARME_C) {
      solicitudReset = true;

      publicarAlerta(
          "REARME_SOLICITADO",
          "Revisando condiciones");
    } else {
      publicarAlerta(
          "REARME_RECHAZADO",
          "Condiciones inseguras");
    }
  }
}

// Consume los comandos que la tarea de red dejo en la cola.
void procesarComandos() {
  ComandoRaw comando;

  while (xQueueReceive(colaComandos, &comando, 0) == pdTRUE) {
    ejecutarComando(comando.json);
  }
}

// ============================================================================
// 24. MANTENIMIENTO DE CONEXIONES: SOLO TAREA DE RED
// ============================================================================

void mantenerConexiones() {
  // Sin WiFi no se intenta conectar MQTT.
  // Se vuelve a solicitar conexion WiFi cada 10 segundos.
  if (WiFi.status() != WL_CONNECTED) {
    if (millis() - ultimoWiFiIntentoMs >= 10000UL) {
      ultimoWiFiIntentoMs = millis();
      WiFi.begin(WIFI_SSID, WIFI_PASS);
    }

    return;
  }

  // Con WiFi y sin MQTT, intentar conectar cada 5 segundos.
  // La llamada connect() puede esperar; por eso se hace en la tarea de red.
  if (!mqtt.connected() &&
      millis() - ultimoMqttIntentoMs >= 5000UL) {
    ultimoMqttIntentoMs = millis();

    if (mqtt.connect(mqttClientId)) {
      Serial.println("[EVENTO RED] MQTT conectado");

      // Se renueva la suscripcion despues de cada conexion exitosa.
      if (!mqtt.subscribe(TOPIC_COMANDOS)) {
        Serial.println(
            "[EVENTO RED] No se pudo enviar la suscripcion a comandos");
      }
    } else {
      Serial.println("[EVENTO RED] Fallo el intento de conexion MQTT");
    }
  }
}

// Callback ejecutado al procesar mensajes MQTT.
// No maneja directamente las salidas del tanque.
void alRecibirMensaje(
    char* topic,
    byte* payload,
    unsigned int length) {
  ComandoRaw comando;

  // Rechaza mensajes vacios o que no caben con su terminador.
  if (length == 0 || length >= sizeof(comando.json)) return;

  memcpy(comando.json, payload, length);
  comando.json[length] = '\0';

  // Sin espera: si la cola esta llena, el comando puede perderse.
  // El parametro topic no se utiliza para filtrar en esta funcion.
  xQueueSend(colaComandos, &comando, 0);
}

// ============================================================================
// 25. PUBLICACION DE ALERTAS Y TELEMETRIA
// ============================================================================

void publicarAlertasPendientes() {
  Alerta alerta;

  while (xQueueReceive(colaAlertas, &alerta, 0) == pdTRUE) {
    // La alerta ya fue retirada de la cola.
    // Si no hay MQTT, se descarta sin reintento.
    if (!mqtt.connected()) continue;

    char payload[200];

    snprintf(
        payload,
        sizeof(payload),
        "{\"tipo\":\"%s\",\"mensaje\":\"%s\",\"ts_ms\":%lu}",
        alerta.tipo,
        alerta.mensaje,
        alerta.ts);

    // El resultado de publicar alertas no se cuenta en [ENVIOS].
    // Aqui no se comprueba el retorno de publish().
    mqtt.publish(TOPIC_ALERTAS, payload);
  }
}

void publicarTelemetriaPendiente() {
  char copia[700];

  // Espera hasta 20 ms por el buffer compartido.
  if (xSemaphoreTake(
          mutexTelemetria,
          pdMS_TO_TICKS(20)) != pdTRUE) {
    diagnosticoRed.mutexOcupado++;
    return;
  }

  // No hay una muestra nueva: liberar el mutex y terminar.
  if (!telemetriaLista) {
    xSemaphoreGive(mutexTelemetria);
    return;
  }

  strlcpy(copia, telemetriaCompartida, sizeof(copia));

  // La muestra se marca consumida ANTES del intento de envio.
  // Esta version no conserva muestras fallidas para reenviarlas.
  telemetriaLista = false;

  // La operacion de red ocurre fuera del mutex.
  xSemaphoreGive(mutexTelemetria);

  diagnosticoRed.bytes = (unsigned int)strlen(copia);

  if (!mqtt.connected()) {
    diagnosticoRed.descartados++;
    diagnosticoRed.resultado = "DESCARTADO_SIN_MQTT";
    return;
  }

  bool enviado = mqtt.publish(TOPIC_TELEMETRIA, copia);

  if (enviado) {
    diagnosticoRed.enviados++;
    diagnosticoRed.ultimoEnvioMs = millis();

    // Exito LOCAL de la publicacion.
    // No es una confirmacion del dashboard.
    diagnosticoRed.resultado = "OK_LOCAL";
  } else {
    diagnosticoRed.errores++;
    diagnosticoRed.resultado = "ERROR_PUBLICACION";
  }
}

// ============================================================================
// 26. TAREA DEDICADA DE COMUNICACIONES
// ============================================================================

void tareaRed(void* parametro) {
  for (;;) {
    mantenerConexiones();

    // Procesa recepcion de mensajes y mantenimiento de la sesion MQTT.
    if (mqtt.connected()) {
      mqtt.loop();
    }

    publicarAlertasPendientes();
    publicarTelemetriaPendiente();

    // Diagnostico al finalizar esta vuelta.
    // Si alguna operacion anterior tarda, esta marca se actualiza mas tarde.
    diagnosticoRed.activa = true;
    diagnosticoRed.wifi = WiFi.status() == WL_CONNECTED;
    diagnosticoRed.mqtt = mqtt.connected();
    diagnosticoRed.codigoMqtt = mqtt.state();
    diagnosticoRed.actividadMs = millis();

    // Publica una copia consistente para el monitor del control.
    portENTER_CRITICAL(&mutexDiagnostico);
    diagnosticoCompartido = diagnosticoRed;
    portEXIT_CRITICAL(&mutexDiagnostico);

    // Cede tiempo a otras tareas. No imprime cada 10 ms.
    vTaskDelay(pdMS_TO_TICKS(10));
  }
}

